<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rozcestník map</title>
    <%- include('icons.ejs'); %>
    <!-- d3.js -->
    <script src="https://d3js.org/d3.v4.min.js"></script>
    <script src="https://d3js.org/d3-scale-chromatic.v1.min.js"></script>
    <script src="https://d3js.org/topojson.v2.min.js"></script>
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <!-- -->
    <meta name="color-scheme" content="light dark">
    <link rel="stylesheet" href="/společné/styl.css">
    <style>
         * {
                color: light-dark(#212529, white);
            }

            body {
                background: light-dark(rgba(235, 255, 255, 0.9), #212529);
            }

            main {
                top: 50px;
                position: relative;
                padding: 2px 10vw;
            }

            main a {
                text-decoration: underline;
                color: #41caff;
                font-weight: bold;
            }

            h1, h2, h3, h4, h5, h6 {
                font-weight: bold;
            }

            h1::first-letter {
                text-transform: capitalize;
            }

            .subunit {
                cursor: pointer;
            }

            #obvody a:hover {
                color: #d80036;
            }

            nav {
                background: light-dark(rgb(236, 246, 255), #070707);
            }

            #mapy a {
                width: 100%;
                border: solid;
                height: 100px;
                align-content: center;
                max-width: 300px;
            }
    </style>
</head>
<body style="overflow: auto; position: absolute;">
    <%- include('menu.ejs') %>
    <main>
        <section style="margin-top: 20px;">
            <h1 style="margin-bottom: 20px;"><%- info["název"]%>: <% console.log(obvody) %></h1>
            <h2>Základní volební údaje</h2>
            <ul>
                <li>Počet oprávněných voličů:</li>
                <li>Počet skutečných voličů:</li>
                <li>Volební účast:</li>
                <li>Vítěz voleb:</li>
            </ul>
        </section>
        <section style="display: flow-root; height: initial;">
            <h2>Přehled map</h2>
            <!-- <ul>
                <li><a href="./">výsledky voleb</a></li>
                <li><a href="samostatné">výsledky voleb pro jednotlivé strany/koalice</a></li>
                <li><a href="./?koalice">výsledky voleb s vlastními koalicemi</a></li>
                <li><a href="ucast">volební účast</a></li>
            </ul> -->
            <div id="mapy" style="display: grid;gap: 20px;margin: 20px 0;">
                <div style="display: flex; justify-content: center; text-align: center; gap: 20px;">
                    <a href="./">výsledky voleb</a>
                    <a href="samostatné">výsledky voleb pro jednotlivé strany/koalice</a>
                </div>
                <div style="display: flex; justify-content: center; text-align: center; gap: 20px;">
                    <a href="./?koalice">výsledky voleb s vlastními koalicemi</a>
                    <a href="ucast">volební účast</a>
                </div>
            </div>
        </section>
        <section style="height: initial;">
            <% if(obvody.length > 1)  {%>
            <header><h2>Samosprávné městské části/obvody</h2></header>
            <div style="display: flex;">
                <aside style="width: 40%;">
                    <ul id="obvody">
                        <%
                            for (var i = 0; i < obvody.length ; i++) {%>
                                <li><a href="<%= obvody[i] %>/mapy" target="_blank" class="momc-<%= obvody[i] %>"><%= nazvy[i] %></a>
                                </li>
                            <% } %>
                    </ul>
                </aside>
                <figure style="width: 60%;">
                    <div style="width: 100%; display: flex; justify-content: flex-end;">
                        <svg id="mapa" style="width: 100%; height: inherit;" viewBox="0 0 1450 750"></svg>
                    </div>
                </figure>
            </div>
        </section>
        <script>
        svg = d3.select("#mapa")
        d3.json("volebni_okrsky-topo.json", function(error, data) {
            if (error) throw error;

            subunits = topojson.feature(data, data.objects.tracts) // obce

            var projection = d3.geoMercator()
            .center(d3.geoCentroid(subunits)) //střed obce
            projection.fitExtent([[0, 0], [1450, 750]], subunits);

            var path = d3.geoPath()
                .projection(projection);
            tooltip = d3.select("figure div")
                .append("div")
                .style("position", "absolute")
                .style("visibility", "hidden")
                .style("background", "white")
                .style("border", "solid #222 1px")
                .style("padding", "5px")
            // vykreslíme obce
            svg.selectAll(".subunit")
                .data(subunits.features)
                .enter().append("path")
                .attr("class", function(d) { return `subunit ${d.id} momc-${d.id.split("-")[0]}`; })
                .attr("fill", "#aaa")
                .attr("stroke", "#888")
                .attr("stroke-width", "1")
                .attr("stroke-linejoin", "round")
                .attr("d", path)
                .on("mouseover", function () {
                    this.setAttribute("fill", "#d80036")
                    svg.selectAll(`.${this.classList[2]}`).attr("fill", "#d80036")
                    document.getElementById("obvody").querySelector(`.${this.classList[2]}`).style.color = "#d80036"
                    })
                .on("mouseout", function () {
                    this.setAttribute("fill", "#aaa")
                    svg.selectAll(`.${this.classList[2]}`).attr("fill", "#aaa")
                    document.getElementById("obvody").querySelector(`.${this.classList[2]}`).style.color = ""
                });
                
                <%
                            for (var i = 0; i < obvody.length ; i++) {%>
                                d3.select(`#obvody .momc-<%= obvody[i] %>`)
                                    .on("mouseover", function() {
                                        svg.selectAll(`.momc-<%= obvody[i] %>`).attr("fill", "#f00")
                                        document.getElementById("obvody").querySelector(`.momc-<%= obvody[i] %>`).style.color = "#d80036"
                                    })
                                    .on("mouseout", function() {
                                        svg.selectAll(`.momc-<%= obvody[i] %>`).attr("fill", "#aaa")
                                        document.getElementById("obvody").querySelector(`.momc-<%= obvody[i] %>`).style.color = ""
                                    })
                            <% } %>

            window.onresize = function() {
            projection
                projection.fitExtent([[0, 0], [1450, 750]], subunits);
            svg.selectAll(".subunit")
                .attr("d", path)
            }
            })
        </script>
        <% } %>
    </main>
</body>
</html>