
    <style>

            .subunit {
                cursor: pointer;
            }

            #obvody a:hover {
                color: #d80036;
            }
    </style>
        <% if(obvody.length > 1)  {%>
            <section class="col-span-12">
            <header><h2>Samosprávné městské části/obvody</h2></header>
            <div style="display: flex;">
                <aside style="width: 40%;">
                    <ul id="obvody">
                        <%
                            for (var i = 0; i < obvody.length ; i++) {%>
                                <li><a href="<%= obvody[i] %>/mapy" target="_blank" class="momc-<%= obvody[i] %>"><%= nazvy[i] %></a>
                                </li>
                            <% } %>
                    </ul>
                </aside>
                <figure style="width: 60%;">
                    <div style="width: 100%; display: flex; justify-content: flex-end;">
                        <svg id="mapa" style="width: 100%; height: inherit;" viewBox="0 0 1450 750"></svg>
                    </div>
                </figure>
            </div>
        </section>
        <script type="module">
            const svg = d3.select("#mapa") // u někomunálních voleb nutnost filtrace
            const data = await d3.json(<% if(info['druh'] !== 'komunální') {%>"../../volebni_okrsky-topo.json"<%} {%>"volebni_okrsky-topo.json"<%} %>)

            const subunits = topojson.feature(data, data.objects.tracts) // obce

            var projection = d3.geoMercator()
            .center(d3.geoCentroid(subunits)) //střed obce
            projection.fitExtent([[0, 0], [1450, 750]], subunits);

            var path = d3.geoPath()
                .projection(projection);
            let tooltip = d3.select("figure div")
                .append("div")
                .style("position", "absolute")
                .style("visibility", "hidden")
                .style("background", "white")
                .style("border", "solid #222 1px")
                .style("padding", "5px")
            // vykreslíme obce
            svg.selectAll(".subunit")
                .data(subunits.features)
                .enter().append("path")
                .attr("class", function(d) { return `subunit ${d.id} momc-${d.id.split("-")[0]}`; })
                .attr("fill", "#aaa")
                .attr("stroke", "#888")
                .attr("stroke-width", "1")
                .attr("stroke-linejoin", "round")
                .attr("d", path)
                .on("mouseover", function () {
                    this.setAttribute("fill", "#d80036")
                    svg.selectAll(`.${this.classList[2]}`).attr("fill", "#d80036")
                    document.getElementById("obvody").querySelector(`.${this.classList[2]}`).style.color = "#d80036"
                    })
                .on("mouseout", function () {
                    this.setAttribute("fill", "#aaa")
                    svg.selectAll(`.${this.classList[2]}`).attr("fill", "#aaa")
                    document.getElementById("obvody").querySelector(`.${this.classList[2]}`).style.color = ""
                });
                
                <%
                            for (var i = 0; i < obvody.length ; i++) {%>
                                d3.select(`#obvody .momc-<%= obvody[i] %>`)
                                    .on("mouseover", function() {
                                        svg.selectAll(`.momc-<%= obvody[i] %>`).attr("fill", "#f00")
                                        document.getElementById("obvody").querySelector(`.momc-<%= obvody[i] %>`).style.color = "#d80036"
                                    })
                                    .on("mouseout", function() {
                                        svg.selectAll(`.momc-<%= obvody[i] %>`).attr("fill", "#aaa")
                                        document.getElementById("obvody").querySelector(`.momc-<%= obvody[i] %>`).style.color = ""
                                    })
                            <% } %>

            window.onresize = function() {
            projection
                projection.fitExtent([[0, 0], [1450, 750]], subunits);
            svg.selectAll(".subunit")
                .attr("d", path)
            }
        </script>
        <% } %>