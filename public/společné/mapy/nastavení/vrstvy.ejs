<%
const vrstvy = [
    {
        "název": "Sudety",
        "volby": ["prezidentské", "krajské", "sněmovní"],
        "oblast": "stát",
        "selector": "protektorat"
    },

    {
        "název": "okresy 1950",
        "volby": ["prezidentské", "krajské", "sněmovní"],
        "oblast": "stát",
        "selector": "okresy1950"
    },

    {
        "název": "okresy1960",
        "volby": ["prezidentské", "krajské", "sněmovní"],
        "oblast": "stát",
        "selector": "okresy1960"
    }
]

let kespusteni = []


vrstvy.forEach(element => {
    if(element.volby.indexOf(info["druh"]) >= 0) {
        kespusteni.push(element)
    }
});

if(kespusteni.length > 0) {
    pocetnastaveni +=1
    %>
    <script>
        function zpracovatvrstvu() {
            // reset zobrazení
            <% kespusteni.forEach(element => {
                %>document.getElementById("<%= element['selector'] %>").style.display = 'none';<%
            }) %>

            switch (document.getElementById("vrstvy").value) {
                <% kespusteni.forEach(element => {
                    %>case "<%= element['název'] %>":
                    if(document.getElementById("skryt-zobrazit").checked) {
                        document.getElementById('<%= element["selector"] %>').style.display = 'inline'
                    } else {
                        document.getElementById('<%= element["selector"] %>').style.display = 'none'
                    }
                    document.getElementById("vrstvy").setAttribute("data-selector", '<%= element["selector"] %>')
                    //document.querySelector('#datahub').style.display = this.checked ? 'inline' : 'none'; if(this.checked) {nazev += ' - okresy 1960'} else {nazev = nazev.replace(' - okresy 1960', '')}
                    break;<%
                }); %>
            }
        }
    </script>
    <div>
        <h3>Vrstvy</h3>
        <select id="vrstvy" class="form-select" style="display: block;">
            <option value="" selected disabled style="display: none;">vyber vrstvu</option>
            <% kespusteni.forEach(element => {
                %><option value="<%= element["název"] %>"><%= element["název"] %></option><%
            }) %>
        </select>
        <input type="color" id="barva" value="white" onchange="let barva = this.value; d3.select(`.${document.getElementById('vrstvy').getAttribute('data-selector')}`).attr('stroke', this.value);"><label for="barva">barva ohraničení vrstvy</label>
        <br>
        <input type="checkbox" id="skryt-zobrazit" onchange="zpracovatvrstvu()"><label for="skryt-zobrazit">zobrazit vrstvu</label>
    </div>
<% } %>