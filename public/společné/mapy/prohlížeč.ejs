    <!-- barevné režimy -->
    <script src="/společné/light-dark.js"></script>
    <%- include('menu.ejs') %>
    <section>
      <div id="nacitani">
        <div class="nacitacianimace"></div>
      </div>
      <div id="otocit">
        <p>Tak zas po přetočení...</p>
      </div>
      <figure id="prohlizec" style="visibility: hidden;">
        <div id="nastroje">
          <button id="stahnout" class="btn" title="Stáhnout mapu"><i class="bi bi-download"></i></button>
          <button class="btn" title="Nastavení" onclick="document.getElementById('nastaveni').style.visibility = 'visible'"><i class="bi bi-gear"></i></button>
          <section id="mapa-orientace">
            <button id="zoom-in" title="Přiblížit" class="btn"><i class="bi bi-zoom-in"></i></button>
            <button id="zoom-out" title="Oddálit" class="btn"><i class="bi bi-zoom-out"></i></button>
            <button id="reset-zoom" title="Resetovat přiblížení" class="btn">Reset</button>
          </section>
          <div id="kompas">            
            <div class="horizontalni">
              <div id="doleva" title="doleva">
                <i class="fa-solid fa-angle-left"></i>
              </div>
              <div id="doprava" title="doprava">
                <i class="fa-solid fa-angle-right"></i>
              </div>
            </div>            
            <div class="vertikalni">
              <div id="nahoru" title="nahoru">
                <i class="fa-solid fa-angle-up"></i>
              </div>
              <div id="dolu" title="dolů">
                <i class="fa-solid fa-angle-down"></i>
              </div>
            </div>
          </div>
        </div>
        <div id="kontejner-mapy">
          <svg xmlns="http://www.w3.org/2000/svg" id="mapa" viewBox="0 0 1450 750">
            <g id="vysledky" style="cursor: all-scroll;"></g>
            <% const vrstvy = JSON.parse(include('vrstvy/vrstvy.json')) %>
            <% vrstvy.forEach(element => {%>
              <g id='<%- element["selector"] %>' style="display: none;"></g><%
            }); %>
          </svg>
        </div>
        <div id="vyber">
          <!-- začátek sekce pouze pro samostatné mapy -->
          <% if(typzobrazeni == "samostatné") {%>
          <select id="seznam" class="form-select" onchange="location.href='?strana=' + this.value">
            <option disabled selected style="display: none">vyber subjekt</option>
          </select><% } %>
          <!-- konec sekce pouze pro samostatné mapy -->
        </div>
        <button id="otevrit-legendu" onclick="document.getElementById('info').style.visibility = 'visible'">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-info-circle-fill" viewBox="0 0 16 16" style="zoom: 2.4;background: black;border-radius: 8px;">
            <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2"></path>
          </svg>
        </button>
        <dialog id="nastaveni" open>
          <header>
            <h2>Nastavení</h2>
          </header>
          <section>
            <%- include('nastavení.ejs') %>
            <button class="btn" onclick="document.getElementById('nastaveni').style.visibility = 'hidden'">Zavřít</button>
          </section>
        </dialog>
        <dialog id="info" open> <!-- open pouze z důvodu správného zobrazení legendy, u ostatních kvůli konzistenci -->
          <header>
            <h2>Info</h2>
          </header>
          <section>
            <p id="popisek"></p>
          </section>
          <header>
            <h2>Legenda</h2>
          </header>
          <section>
            <svg id="legenda" viewBox="0 0 500 300"></svg>
          </section>
          <button class="btn" onclick="document.getElementById('info').style.visibility = 'hidden'">Zavřít</button>
        </dialog>
      </figure>
    </section>
    <!-- vykreslení mapy -->
    <script type="module">
      import { vykresleni } from '<%- urlvykresleni%>'
      import { infobox } from "/společné/mapy/info/info základ.js"
      import { info } from '<%- urlinfo%>'
      import { vykreslit_vrstvu } from "/společné/mapy/vrstvy/vrstvy.js"
      import * as Zoom from "/společné/mapy/js/zoom.js"


      if(parametry.typzobrazeni == "samostatné") {if(parametry.hledanastrana == null) {document.getElementById("nacitani").style.display = "none"; document.getElementById("prohlizec").style.visibility = "visible"}}

      vykresleni(d3.select("#mapa g"), parametry.druh)
      .then(function({subunits, strany}) {
        infobox(subunits, strany, info)
        if(typeof(vrstvyjson) !== "undefined") {
          vrstvyjson.forEach(element => {// způsobuje lagy
            vykreslit_vrstvu(subunits, element)
          });
        }
        document.getElementById("stahnout").onclick = function() {stahnout(subunits)}
      })
      .catch(function(error) {
        console.error(error)
        document.getElementById("stahnout").remove()
      })
      .finally(function() {
        document.getElementById("nacitani").style.display = "none"; document.getElementById("prohlizec").style.visibility = "visible";
      })

    //popisek
    function Popisek(popisek) {
      document.getElementById("popisek").innerText = `Mapa volebních výsledků pro ${popisek}`
    }

    <% if(typzobrazeni == "normální" || typzobrazeni == "účast") {%>
    parametry.popisek = `<% if(info["lokalita"]["druh"] == "stát") {%>ČR<%} else {%><%- info["lokalita"]["NAZEVZAST"]%><% }; %>, <%- info["název"] %>`
    Popisek(parametry.popisek)
    <%} else {%>
      //popisek
      import { seznam } from "<%- urlseznam %>"

      seznam().then(function(popisek) {parametry.popisek = `<% if(info["lokalita"]["druh"] == "stát") {%>ČR<%} else {%><%- info["lokalita"]["NAZEVZAST"]%><% }; %>, ${popisek}, <%- info["název"] %>`; Popisek(parametry.popisek)})
    <% } %>
    </script>