<%
pocetnastaveni = 0

souborynastaveni.forEach(element => {
    switch (element) {
        case "vrstvy.ejs":%>
            <%- include(`nastavení/${element}`) %>
            <% break;
        case "legenda.ejs":%>
            <% if(typzobrazeni=="samostatné"||typzobrazeni=="účast"?true:false) {%>
                <%- include(`nastavení/${element}`) %>
            <% } %>
            <% break;
        default:
            break;
    }
});

if(pocetnastaveni == 0) {%>
    <p>Pro tuto mapu nejsou dostupná žádná nastavení.</p>
<%} %>