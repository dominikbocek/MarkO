<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Obce</title>
    <%- include ("../icons.ejs") %>
</head>
<body>
    <h1>Seznam obcí</h1>
    <ul>
        <%
        filtrovano = seznam_obci.filter(function(el) {
            return el !== "" && el !== "\r"
        })

        console.log(filtrovano[filtrovano.length - 1])

        filtrovano.forEach(element => {
            %><li><a href="<%- JSON.parse(element)['KODZASTUP'] %>"><%- JSON.parse(element)["NAZEVZAST"] %></a></li><%
        });
        %>
    </ul>
</body>
</html>